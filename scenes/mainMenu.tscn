[sub_resource type="VisualShader" id="VisualShader_7nrmo"]
code = "shader_type sky;
uniform sampler2D tex : source_color;



void sky() {
// Input:2
	vec2 n_out2p0 = SKY_COORDS;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(tex, n_out2p0);


// Output:0
	COLOR = vec3(n_out3p0.xyz);


}
"
